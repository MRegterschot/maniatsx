{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "maniatsx",
    "types": ["bun"],
    "paths": {
      "maniatsx": ["./src/index.ts"],
      "maniatsx/jsx-runtime": ["./src/jsx-runtime.ts"],
      "maniatsx/jsx-dev-runtime": ["./src/jsx-dev-runtime.ts"],
      "maniatsx/client": ["./src/client/index.ts"],
      "maniatsx/maniascript": ["./src/maniascript/index.ts"]
    }
  },
  "include": ["src", "test", "scripts", "examples", "bench"]
}
