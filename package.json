{
  "name": "maniatsx",
  "version": "0.1.0",
  "description": "Write Trackmania manialinks in TSX",
  "license": "MIT",
  "author": "Marijn Regterschot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MRegterschot/maniatsx.git"
  },
  "homepage": "https://github.com/MRegterschot/maniatsx#readme",
  "bugs": {
    "url": "https://github.com/MRegterschot/maniatsx/issues"
  },
  "keywords": [
    "trackmania",
    "manialink",
    "maniascript",
    "tsx",
    "jsx"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "vendor/LICENSE-manialink-xsd",
    "bin",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./maniascript": {
      "types": "./dist/maniascript/index.d.ts",
      "default": "./dist/maniascript/index.js"
    },
    "./bun-plugin": {
      "types": "./dist/compiler/bun-plugin.d.ts",
      "default": "./dist/compiler/bun-plugin.js"
    },
    "./esbuild-plugin": {
      "types": "./dist/compiler/esbuild-plugin.d.ts",
      "default": "./dist/compiler/esbuild-plugin.js"
    }
  },
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "gen": "bun scripts/gen-intrinsics.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "bench": "bun bench/render.bench.tsx",
    "format": "prettier --write src test scripts examples bench",
    "render": "bun --preload ./scripts/preload-compiler.ts src/cli.ts",
    "gen:maniascript": "bun scripts/gen-maniascript-api.ts",
    "compile": "bun scripts/compile.ts",
    "send": "bun scripts/send-manialink.ts",
    "visual": "bun --preload ./scripts/preload-compiler.ts scripts/visual.ts",
    "bridge:install": "bun scripts/install-bridge.ts",
    "design:capture-glyphs": "bun scripts/capture-glyphs.ts",
    "design:diff": "bun scripts/design-diff.ts",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@evotm/gbxclient": "^1.5.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@maniascript/api": "^10.0.0",
    "@maniascript/parser": "^16.0.0",
    "@types/bun": "^1.4.4",
    "@types/pngjs": "^6.0.5",
    "antlr4ng": "^3.0.16",
    "esbuild": "^0.28.2",
    "fast-xml-parser": "^5.11.2",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "quickjs-emscripten-core": "0.32.0",
    "typescript": "^7.0.2",
    "xmllint-wasm": "^5.3.0"
  },
  "bin": {
    "maniatsx": "bin/maniatsx.js",
    "maniatsx-compile": "bin/maniatsx-compile.js"
  },
  "dependencies": {
    "typescript6": "npm:typescript@6.0.3"
  }
}
