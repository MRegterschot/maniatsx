<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<manialink id="action-group-widget" name="TMCP:action-group-widget" version="3">
  <frame id="widget" pos="-156 85" z-index="10" hidden="1">
    <frame pos="0 0" size="20 5" z-index="10">
      <frame size="20 5" pos="-15 0" id="mtx-1">
        <frame pos="15 0" size="5 5">
          <quad size="5 5" bgcolor="222" />
          <label pos="2.6 -2.15" text="" halign="center" valign="center" textsize="2.5" textcolor="DDD" id="mtx-2" />
        </frame>
        <frame pos="0 0" size="5 5">
          <quad size="5 5" bgcolor="DDD" action="open-maps" />
          <quad image="https://example.com/icons/maps.png" size="3.5 3.5" pos="0.75 -0.75" />
        </frame>
        <frame pos="5 0" size="5 5">
          <quad size="5 5" bgcolor="DDD" action="open-players" />
          <label pos="2.5 -2.1" text="" halign="center" valign="center" textsize="2" textcolor="222" />
        </frame>
        <frame pos="10 0" size="5 5">
          <quad size="5 5" bgcolor="DDD" action="open-settings" />
          <label pos="2.5 -2.1" text="" halign="center" valign="center" textsize="2" textcolor="222" />
        </frame>
        <quad pos="15 0" z-index="2" size="5 5" bgcolor="222" opacity="0" id="mtx-3" scriptevents="1" />
      </frame>
    </frame>
  </frame>
  <script><!--
#Include "MathLib" as ML
#Include "TextLib" as TL
#Include "TimeLib" as TimeLib
#Include "ColorLib" as CL
declare CMlFrame widget;
declare CMlFrame Mtx_R1;
declare CMlLabel Mtx_R2;
Void Mtx_H1() {
declare Boolean Mtx_P_actiongroup_fa4d5dac for Page;
declare CAnimManager::EAnimManagerEasing ease = CAnimManager::EAnimManagerEasing::ExpInOut;
if (Mtx_P_actiongroup_fa4d5dac) {
  AnimMgr.Add(Mtx_R1, "<frame pos='" ^ -15. ^ " 0' />", 200, ease);
  AnimMgr.Add(Mtx_R2, "<label rot='0' pos='2.6 -2.15' />", 200, ease);
} else {
  AnimMgr.Add(Mtx_R1, "<frame pos='0 0' />", 200, ease);
  AnimMgr.Add(Mtx_R2, "<label rot='180' pos='2.25 -2.9' />", 200, ease);
}
Mtx_P_actiongroup_fa4d5dac = !Mtx_P_actiongroup_fa4d5dac;
}
main() {
  Mtx_R1 <=> (Page.MainFrame.GetFirstChild("mtx-1") as CMlFrame);
  Mtx_R2 <=> (Page.MainFrame.GetFirstChild("mtx-2") as CMlLabel);
  declare Boolean Mtx_P_actiongroup_fa4d5dac for Page = False;
  widget <=> (Page.MainFrame.GetFirstChild("widget") as CMlFrame);

  sleep(300);
  widget.Show();
  while (True) {
    yield;
    foreach (Event in PendingEvents) {
      if (Event.Control == Null) continue;
      if (Event.Type == CMlScriptEvent::Type::MouseClick && Event.ControlId == "mtx-3") Mtx_H1();
    }
  }
}
--></script>
</manialink>
