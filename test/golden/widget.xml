<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<manialink id="example-widget" name="TMCP:example-widget" version="3">
  <frame id="widget" pos="120 80" z-index="10" hidden="1">
    <quad size="40 10" bgcolor="222" />
    <label pos="20 -5" text="52341" textprefix="Last: " halign="center" valign="center" textsize="2" textcolor="DDD" />
  </frame>
  <script><!--
#Include "MathLib" as ML
#Include "TextLib" as TL
#Include "TimeLib" as TimeLib
#Include "ColorLib" as CL
declare CMlFrame widget;
declare Boolean Mtx_Dirty;
declare Vec2 Mtx_S1;
declare Boolean Mtx_S2;
declare Integer Mtx_S3;
Void Mtx_F_hide_while_driving_slideTo(CMlFrame _frame, Real _x, Real _y, Integer _duration, CAnimManager::EAnimManagerEasing _easing) {
  AnimMgr.Add(_frame, "<frame pos='" ^ _x ^ " " ^ _y ^ "' />", _duration, _easing);
}
main() {
  Mtx_S1 = <0., 0.>;
  Mtx_S2 = False;
  Mtx_S3 = -1;
  widget <=> (Page.MainFrame.GetFirstChild("widget") as CMlFrame);

  sleep(300);
  widget.Show();
  {
    declare CMlFrame frame <=> (Page.MainFrame.GetFirstChild("widget") as CMlFrame);
    Mtx_S1 = frame.RelativePosition_V3;
    Mtx_Dirty = True;
  }
  Mtx_Dirty = True;
  while (True) {
    yield;
    foreach (Event in PendingEvents) {
      if (Event.Control == Null) continue;
    }
    {
      declare CMlFrame frame <=> (Page.MainFrame.GetFirstChild("widget") as CMlFrame);
      declare CSmPlayer player <=> InputPlayer;
      if (player == Null) {
        if (Mtx_S2) {
          Mtx_S2 = False;
          Mtx_Dirty = True;
          Mtx_F_hide_while_driving_slideTo(frame, Mtx_S1.X, Mtx_S1.Y, 600, CAnimManager::EAnimManagerEasing::CircOut);
        }
      } else if (ML::Abs(player.Speed * 3.6) > 10.) {
        if (Mtx_S3 != -1) {
          Mtx_S3 = -1;
          Mtx_Dirty = True;
        }
        if (!Mtx_S2) {
          Mtx_S2 = True;
          Mtx_Dirty = True;
          declare Real x = 322.;
          if (frame.AbsolutePosition_V3.X < 0.) {
            x = frame.Size.X * -frame.RelativeScale - 322.;
          }
          Mtx_F_hide_while_driving_slideTo(frame, x, Mtx_S1.Y, 1000, CAnimManager::EAnimManagerEasing::ExpInOut);
        }
      } else if (Mtx_S2) {
        if (Mtx_S3 == -1) {
          Mtx_S3 = Now;
          Mtx_Dirty = True;
        } else if (Now - Mtx_S3 >= 1000) {
          Mtx_S2 = False;
          Mtx_Dirty = True;
          Mtx_S3 = -1;
          Mtx_Dirty = True;
          Mtx_F_hide_while_driving_slideTo(frame, Mtx_S1.X, Mtx_S1.Y, 600, CAnimManager::EAnimManagerEasing::CircOut);
        }
      }
    }
    Mtx_Dirty = False;
  }
}
--></script>
</manialink>
